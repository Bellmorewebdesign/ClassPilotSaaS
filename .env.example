# ---------------------------------------------------------------------------
# ClassPilot environment configuration
#
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
#   cp .env.example .env
#
# Both apps read this single root .env file.
# ---------------------------------------------------------------------------

# --- MongoDB ---------------------------------------------------------------
# MongoDB Atlas is the intended development database. ClassPilot does NOT
# require a local MongoDB.
#
# Atlas setup:
#   1. https://cloud.mongodb.com -> create a free M0 cluster
#   2. Database Access -> add a database user (username + password)
#   3. Network Access -> add your current IP address
#   4. Connect -> Drivers -> copy the connection string
#   5. Replace <password> below with that user's password
#
# A local MongoDB works too:  mongodb://localhost:27017
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=classpilot

# --- API server ------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
NODE_ENV=development

# Largest sync request body accepted, in bytes.
MAX_BODY_BYTES=4000000

# --- Authentication (V1 development mode) ----------------------------------
# V1 ships a single development user instead of a full auth system.
# AUTH_MODE=production is reserved and will refuse to boot until real SaaS
# authentication is implemented.
AUTH_MODE=dev

# The bearer token the Chrome extension presents to the API.
# GENERATE YOUR OWN — do not use the placeholder:
#
#   openssl rand -hex 32
#
# Only its SHA-256 hash is ever stored in the database or written to logs.
# You paste this value into the extension popup once; it is never baked into
# the extension source.
DEV_EXTENSION_TOKEN=replace-me-with-openssl-rand-hex-32

DEV_USER_EMAIL=dev@classpilot.local
DEV_USER_DISPLAY_NAME=ClassPilot Dev User

# --- CORS ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Allow chrome-extension:// origins. The extension's origin depends on its
# generated id, so it is matched by scheme. Required for the extension to
# sync; set to false to lock the API down to the web app only.
ALLOW_EXTENSION_ORIGINS=true

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# --- Logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable colourized logs. Leave false in production (JSON to stdout).
LOG_PRETTY=true

# --- Scraper debugging -----------------------------------------------------
# Persist extraction reports with each sync run so selector regressions can be
# diagnosed. Reports contain field names and strategy names only — never
# assignment content.
SCRAPER_DEBUG=false

# --- Web app ---------------------------------------------------------------
# Server-side: where the Next.js app reaches the API.
CLASSPILOT_API_URL=http://localhost:4000
# The web app authenticates to the API with the same dev token.
CLASSPILOT_API_TOKEN=replace-me-with-the-same-value-as-DEV_EXTENSION_TOKEN

# Browser-side: shown in the UI so you know which API the dashboard reads.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Tests -----------------------------------------------------------------
# Optional. Point the database integration tests at a SCRATCH database; their
# collections are dropped between tests. Without this, those suites try
# mongodb-memory-server and skip if it cannot start.
# MONGODB_TEST_URI=mongodb://localhost:27017/classpilot_test
