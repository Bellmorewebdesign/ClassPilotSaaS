{
  "name": "@classpilot/extension",
  "version": "0.1.0",
  "private": true,
  "description": "ClassPilot Chrome extension (MV3) - syncs Google Classroom from the user's own authenticated browser session.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "package": "node build.mjs && cd dist && zip -r ../classpilot-extension.zip ."
  },
  "dependencies": {
    "@classpilot/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "esbuild": "^0.25.0",
    "happy-dom": "^16.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
