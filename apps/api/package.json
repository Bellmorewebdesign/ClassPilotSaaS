{
  "name": "@classpilot/api",
  "version": "0.1.0",
  "private": true,
  "description": "ClassPilot API - validates and stores Classroom records synced by the Chrome extension.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@classpilot/shared": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "mongodb-memory-server": "^10.1.4",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
